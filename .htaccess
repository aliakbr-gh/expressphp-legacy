Options -Indexes
RewriteEngine On
DirectoryIndex index.php index.html

# Deny hidden files regardless of whether they exist.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Preserve Bearer and Basic Authorization headers through Apache rewrites.
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

# Source, storage, CLI, and metadata must never be fetched as files.
# Prefer public/ as the document root; these rules protect the project root only when Apache honors .htaccess.
# Verify every deployment with: php cli/check-deploy https://your-domain
RewriteRule ^(?:\.git|public|cli|LICENSE|app|config|migrations|routes|src|storage|tests)(?:/|$) - [F,L,NC]
RewriteRule \.md$ - [F,L,NC]

# Every other URL, including /api/v1/..., enters the front controller.
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [QSA,L]
